# Copy to ~/.config/connector-sync.env (or point CONNECTOR_SYNC_CONFIG at your copy).

# Folder Claude runs in. Everything below is relative to it.
VAULT="$HOME/notes"

# Items land in $VAULT/$RAW_DIR/<source>/.
RAW_DIR="raw"

# Health files, logs and last-success dates, one set per source.
STATE_DIR=".connector-sync"

# Where your prompt files live. Defaults to the sources/ folder next to the scripts.
# SOURCES_DIR="$HOME/.config/connector-sync/sources"

# First run looks back DEFAULT_DAYS. After a failure, the next good run catches up,
# but never further back than MAX_DAYS.
DEFAULT_DAYS=2
MAX_DAYS=30
